# Copy to `.env.production` for the first deployment. The real file is ignored
# by Git and is uploaded only as encrypted Worker secrets.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-bytes
# Use the same initial secret as BETTER_AUTH_SECRET, prefixed with version 1.
BETTER_AUTH_SECRETS=1:replace-with-the-same-random-secret

# Google Web client ID and Android application ID are non-secret Wrangler vars.
# Native ID-token sign-in does not use a Google client secret.
