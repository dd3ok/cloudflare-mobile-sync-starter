    "expo-secure-store": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-google-signin": "2.0.0",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4",
    "@expo/dom-webview": "58.0.2"
