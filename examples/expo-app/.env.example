# Consuming-app values are bundled and public. Never place a provider secret,
# Better Auth secret, Cloudflare token, or D1 identifier here.
EXPO_PUBLIC_MOBILE_SYNC_URL=http://127.0.0.1:8787
# Leave empty for local-only use. Set to `google` after native Web/Android clients are configured.
EXPO_PUBLIC_MOBILE_SYNC_PROVIDERS=
